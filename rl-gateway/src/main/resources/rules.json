{
  "etag": "local",
  "rules": [
    {
      "serviceId": "orders",
      "ruleId": "per-user",
      "match": { "method": "GET", "path": "/v1/orders/**" },
      "keyBy": "userId",
      "capacity": 5,
      "refillPerSec": 0.1,
      "onFailure": "local_fallback",
      "enabled": true,
      "version": 0
    }
  ]
}
